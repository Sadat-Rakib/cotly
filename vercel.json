{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://cotly.cotly-app.workers.dev/api/:path*" },
    { "source": "/oauth/:path*", "destination": "https://cotly.cotly-app.workers.dev/oauth/:path*" },
    { "source": "/((?!api/|oauth/).*)", "destination": "/index.html" }
  ]
}
