{
  "name": "cotly",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run db:local && wrangler dev --config ./wrangler.toml",
    "dev:cotly": "npm run dev",
    "build": "vite build",
    "test": "vitest run",
    "deploy": "npm run build && wrangler deploy --config ./wrangler.toml",
    "db:local": "wrangler d1 migrations apply cotly-db --local",
    "db:remote": "wrangler d1 migrations apply cotly-db --remote",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.19",
    "@cloudflare/workers-types": "^5",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.3",
    "wrangler": "^4.14.1"
  }
}
